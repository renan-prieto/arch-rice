#!/bin/bash

SETTINGS="$HOME/.config/Code - OSS/User/settings.json"
WAL="$HOME/.cache/wal/vscode-settings.json"

python - "$SETTINGS" "$WAL" <<'PY'
import json
import sys
import re

settings_file = sys.argv[1]
wal_file = sys.argv[2]

with open(settings_file, "r", encoding="utf-8") as f:
    content = f.read()

# Remove comentários // e /* */
content = re.sub(r'/\*.*?\*/', '', content, flags=re.S)
content = re.sub(r'^\s*//.*$', '', content, flags=re.M)

# Remove vírgulas antes de } ou ]
content = re.sub(r',(\s*[}\]])', r'\1', content)

settings = json.loads(content)

with open(wal_file, "r", encoding="utf-8") as f:
    wal = json.load(f)

settings["workbench.colorCustomizations"] = wal["workbench.colorCustomizations"]

with open(settings_file, "w", encoding="utf-8") as f:
    json.dump(settings, f, indent=4, ensure_ascii=False)
    f.write("\n")
PY
