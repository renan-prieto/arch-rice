#!/bin/bash

WALLPAPER="$1"
WAL="$HOME/.cache/wal"
CURRENT="$HOME/.cache/current-wallpaper"

if [ -z "$WALLPAPER" ]; then
    echo "Uso: wallpaper <arquivo>"
    exit 1
fi

if [ ! -f "$WALLPAPER" ]; then
    echo "Erro: wallpaper não encontrado: $WALLPAPER"
    exit 1
fi

WALLPAPER="$(realpath "$WALLPAPER")"

echo "[1/5] Aplicando wallpaper..."

feh --no-fehbg --bg-fill "$WALLPAPER"

# Salva o wallpaper atual
printf '%s\n' "$WALLPAPER" > "$CURRENT"

echo "[2/5] Gerando paleta Pywal..."

wal -i "$WALLPAPER" -n

echo "[3/5] Atualizando Polybar..."

# Atualiza a Polybar imediatamente após o Pywal
"$HOME/.config/polybar/launch.sh" 

echo "[4/5] Atualizando lockscreen..."

# Só depois gera o cache do Betterlockscreen
~/.config/i3/scripts/update-lockscreen.sh
echo "[5/5] Atualizando Kitty..."

if command -v kitty >/dev/null 2>&1; then
    kitty @ set-colors --all "$WAL/colors-kitty.conf" >/dev/null 2>&1
fi

echo
echo "✓ atualizado"

