! X colors.
! Generated by 'wal'
*foreground:        #cbe6f0
*background:        #121518
*.foreground:       #cbe6f0
*.background:       #121518
emacs*foreground:   #cbe6f0
emacs*background:   #121518
URxvt*foreground:   #cbe6f0
XTerm*foreground:   #cbe6f0
UXTerm*foreground:  #cbe6f0
URxvt*background:   [100]#121518
XTerm*background:   #121518
UXTerm*background:  #121518
URxvt*cursorColor:  #cbe6f0
XTerm*cursorColor:  #cbe6f0
UXTerm*cursorColor: #cbe6f0
URxvt*borderColor:  [100]#121518

! Colors 0-15.
*.color0: #121518
*color0:  #121518
*.color1: #B2A35C
*color1:  #B2A35C
*.color2: #5D7083
*color2:  #5D7083
*.color3: #B1739C
*color3:  #B1739C
*.color4: #68B6C5
*color4:  #68B6C5
*.color5: #DA96AF
*color5:  #DA96AF
*.color6: #C5A5BC
*color6:  #C5A5BC
*.color7: #cbe6f0
*color7:  #cbe6f0
*.color8: #8ea1a8
*color8:  #8ea1a8
*.color9: #B2A35C
*color9:  #B2A35C
*.color10: #5D7083
*color10:  #5D7083
*.color11: #B1739C
*color11:  #B1739C
*.color12: #68B6C5
*color12:  #68B6C5
*.color13: #DA96AF
*color13:  #DA96AF
*.color14: #C5A5BC
*color14:  #C5A5BC
*.color15: #cbe6f0
*color15:  #cbe6f0

! Black color that will not be affected by bold highlighting.
*.color66: #121518
*color66:  #121518

! Xclock colors.
XClock*foreground: #cbe6f0
XClock*background: #121518
XClock*majorColor:  rgba:cb/e6/f0/ff
XClock*minorColor:  rgba:cb/e6/f0/ff
XClock*hourColor:   rgba:cb/e6/f0/ff
XClock*minuteColor: rgba:cb/e6/f0/ff
XClock*secondColor: rgba:cb/e6/f0/ff

! Set depth to make transparency work.
URxvt*depth: 32
