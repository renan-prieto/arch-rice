{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
        "source": "/home/renan/.config/fastfetch/logo/logo.txt",
        "type": "auto",
        "padding": {
            "right": 4
        }
    },

    "display": {
        "separator": " ",
        "color": {
            "keys": "blue",
            "title": "cyan"
        }
    },

    "modules": [
        {
            "type": "title",
            "format": "{user-name}@{host-name}"
        },

        "break",

        {
            "type": "os",
            "key": " OS",
            "format": "{pretty-name}"
        },

        {
            "type": "kernel",
            "key": " Kernel",
            "format": "{release}"
        },

        {
            "type": "uptime",
            "key": "󰅐 Uptime",
            "format": "{days}d {hours}h {minutes}m"
        },

        {
            "type": "wm",
            "key": " WM",
            "format": "{pretty-name} {version}"
        },

        {
            "type": "terminal",
            "key": " Term",
            "format": "{pretty-name}"
        },

        {
            "type": "shell",
            "key": " Shell",
            "format": "{pretty-name}"
        },

        "break",

        {
            "type": "host",
            "key": " PC",
            "format": "{name}"
        },

        {
            "type": "cpu",
            "key": " CPU",
            "format": "{name}"
        },

        {
            "type": "gpu",
            "key": "󰢮 GPU",
            "format": "{name}"
        },

        {
            "type": "memory",
            "key": "󰍛 RAM",
            "format": "{used} / {total} GiB ({percentage}%)"
        },

        {
            "type": "disk",
            "key": "󰋊 Disk",
            "folders": ["/"],
        },

        "break",

        {
            "type": "display",
            "key": "󰹑 Display",
            "format": "{width}x{height} @ {refresh-rate}Hz"
        },

        {
            "type": "packages",
            "key": "󰏖 Packages",
            "format": "{all}"
        },

        {
            "type": "colors",
            "symbol": "circle"
        }
    ]
}


